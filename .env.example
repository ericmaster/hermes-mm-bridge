# Mattermost project in Infisical — secrets fetched at container startup
# Copy this file to .env and fill in your values.
INFISICAL_PROJECT_ID=
INFISICAL_HOST_URL=

# Public Mattermost server URL (not a secret)
MATTERMOST_URL=

# Optional: webhook auth token for the bridge endpoint
# Leave empty to run without auth validation
# HERMES_TOKEN=
